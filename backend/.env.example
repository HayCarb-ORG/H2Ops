# ========================
# SERVER CONFIG
# ========================
PORT=5000


# ========================
# DATABASE (MongoDB Atlas)
# ========================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGO_DB_NAME=mern-auth-spo2-local


# ========================
# AUTH (JWT)
# ========================
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# ========================
# CORS / FRONTEND
# ========================
FRONTEND_URL=http://localhost

# ========================
# FIREBASE / FIRESTORE
# ========================
# Option 1: Paste the JSON string (do NOT commit real credentials)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"<project-id>","private_key_id":"<key-id>","private_key":"-----BEGIN PRIVATE KEY-----\\n<key>\\n-----END PRIVATE KEY-----\\n","client_email":"<client-email>","client_id":"<client-id>","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/<client-email>","universe_domain":"googleapis.com"}

# Option 2 (recommended): point to an untracked JSON file path
# GOOGLE_APPLICATION_CREDENTIALS=../secrets/service-account.json
